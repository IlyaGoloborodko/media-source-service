# All settings are optional; defaults are shown. Prefix is MSS_.
MSS_HOST=0.0.0.0
MSS_PORT=8080
MSS_DEFAULT_SEARCH_LIMIT=10
MSS_MAX_SEARCH_LIMIT=25

# YouTube cookies — set ONE of the following (not both). See README.
# In a container only the cookie file works (no browser there); use LF newlines.
# MSS_YTDLP_COOKIEFILE=/app/cookies.txt
# On a host with a logged-in browser, you can instead read cookies directly:
# MSS_YTDLP_COOKIES_FROM_BROWSER=chrome

# Last.fm API key — enables the /similar and /charts discovery endpoints.
# Without it those endpoints return 503. https://www.last.fm/api/account/create
# MSS_LASTFM_API_KEY=your_lastfm_api_key
